---
interface Row {
  name: string;
  cells: string[];
}

interface Props {
  caption: string;
  /** Column headings, starting with the row-heading column. */
  columns: string[];
  rows: Row[];
}

const { caption, columns, rows } = Astro.props;
---

<div class="comparison not-content" role="region" aria-label={caption} tabindex="0">
  <table>
    <caption>{caption}</caption>
    <thead>
      <tr>
        {columns.map((column) => (
          <th scope="col">{column}</th>
        ))}
      </tr>
    </thead>
    <tbody>
      {rows.map((row) => (
        <tr>
          <th scope="row">{row.name}</th>
          {row.cells.map((cell) => (
            <td>{cell}</td>
          ))}
        </tr>
      ))}
    </tbody>
  </table>
</div>

<style>
  .comparison {
    margin-block: var(--space-5);
    overflow-x: auto;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
  }

  table {
    display: table;
    width: 100%;
    min-width: 34rem;
    border-collapse: collapse;
    color: var(--color-text);
    font-size: var(--sl-text-sm);
  }

  caption {
    padding: var(--space-3) var(--space-4);
    text-align: start;
    font-weight: 700;
    color: var(--color-text-strong);
  }

  th,
  td {
    padding: var(--space-3) var(--space-4);
    border-top: 1px solid var(--color-border);
    text-align: start;
    vertical-align: top;
  }

  thead th {
    background: var(--color-surface-raised);
    font: 500 var(--sl-text-2xs) / 1.3 var(--font-data);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  tbody th {
    font-weight: 600;
    color: var(--color-text-strong);
  }
</style>
