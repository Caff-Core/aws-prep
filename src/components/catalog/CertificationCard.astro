---
import { certificationUrl, levelLabels } from '~/lib/certifications/registry';
import type { Certification } from '~/lib/certifications/schema';

interface Props {
  certification: Certification;
  lessonCount: number;
}

const { certification, lessonCount } = Astro.props;
const isAvailable = certification.status === 'available';
---

<article class="card" data-status={certification.status}>
  <p class="meta">
    <span class="data-label">{levelLabels[certification.level]}</span>
    <span class="data-label">{certification.examCode ?? 'Exam code TBC'}</span>
  </p>
  <h3>{certification.title}</h3>
  <p class="description">{certification.description}</p>
  <div class="foot">
    {isAvailable ? (
      <>
        <span class="status" data-state="available">
          Available · {lessonCount} {lessonCount === 1 ? 'lesson' : 'lessons'} so far
        </span>
        <a class="button" href={certificationUrl(certification.id)}>
          Open course<span class="sr-only">: {certification.title}</span>
        </a>
      </>
    ) : (
      <span class="status">Coming soon</span>
    )}
  </div>
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: var(--space-5);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    transition: border-color var(--transition-fast);
  }

  .card[data-status='available'] {
    border-color: var(--color-accent);
    box-shadow: var(--shadow-card);
  }

  .card[data-status='planned'] {
    background: transparent;
    border-style: dashed;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-2);
    margin: 0;
  }

  h3 {
    margin: var(--space-3) 0 0;
    font-size: var(--sl-text-xl);
    line-height: 1.2;
    color: var(--color-text-strong);
  }

  .description {
    flex: 1;
    margin: var(--space-2) 0 0;
    font-size: var(--sl-text-sm);
    color: var(--color-text);
  }

  .foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    margin-top: var(--space-4);
  }

  .status {
    font: 500 var(--sl-text-2xs) / 1.3 var(--font-data);
    color: var(--color-text-muted);
  }

  .status[data-state='available'] {
    color: var(--color-accent);
  }
</style>
