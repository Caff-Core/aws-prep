---
import { getAvailableCertification } from '~/lib/certifications/registry';
import { getLessons } from '~/lib/lessons';

interface Props {
  certificationId: string;
}

const { certificationId } = Astro.props;
const { modules } = getAvailableCertification(certificationId);
const lessons = await getLessons(certificationId);
---

<ol class="modules not-content">
  {modules.map((module, index) => {
    const moduleLessons = lessons.filter((lesson) => lesson.meta.module === module.slug);
    return (
      <li>
        <p class="data-label">Module {index + 1}</p>
        <h3>{module.title}</h3>
        <p>{module.description}</p>
        {moduleLessons.length > 0 ? (
          <ul>
            {moduleLessons.map((lesson) => (
              <li>
                <a href={lesson.url}>{lesson.title}</a>
              </li>
            ))}
          </ul>
        ) : (
          <p class="pending">Lessons in production</p>
        )}
      </li>
    );
  })}
</ol>

<style>
  .modules {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: var(--space-4);
    margin-block: var(--space-4);
    padding: 0;
    list-style: none;
  }

  .modules > li {
    padding: var(--space-4) var(--space-5);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    color: var(--color-text);
  }

  .modules p {
    margin: var(--space-1) 0 0;
    font-size: var(--sl-text-sm);
  }

  .modules .data-label {
    margin: 0;
    font-size: var(--sl-text-2xs);
  }

  h3 {
    margin: var(--space-1) 0 0;
    font-size: var(--sl-text-lg);
    color: var(--color-text-strong);
  }

  ul {
    margin: var(--space-2) 0 0;
    padding-inline-start: var(--space-4);
    font-size: var(--sl-text-sm);
  }

  a {
    color: var(--color-accent);
  }

  .modules .pending {
    margin-top: var(--space-2);
    font: 500 var(--sl-text-2xs) / 1.3 var(--font-data);
    color: var(--color-text-muted);
  }
</style>
