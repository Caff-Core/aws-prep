---
import { getAvailableCertification } from '~/lib/certifications/registry';

interface Props {
  certificationId: string;
}

const { domains } = getAvailableCertification(Astro.props.certificationId);
---

<ol class="strata not-content">
  {[...domains].reverse().map((domain) => (
    <li style={`--weight: ${domain.weightPercent}; --stratum: var(--stratum-${domain.number})`}>
      <span class="title">{domain.title}</span>
      <span class="weight">{domain.weightPercent}%</span>
    </li>
  ))}
</ol>

<style>
  .strata {
    display: flex;
    flex-direction: column;
    gap: 3px;
    height: 100%;
    min-height: 20rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    flex: var(--weight) 1 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    min-height: 3rem;
    padding: var(--space-2) var(--space-4);
    background: var(--stratum);
    color: var(--on-stratum);
  }

  li:first-child {
    border-radius: var(--radius-md) var(--radius-md) 0 0;
  }

  li:last-child {
    border-radius: 0 0 var(--radius-md) var(--radius-md);
  }

  .title {
    font-weight: 600;
    line-height: 1.2;
  }

  .weight {
    font: 700 var(--sl-text-lg) / 1 var(--font-data);
  }
</style>
