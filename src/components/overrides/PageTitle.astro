---
import { certificationUrl, getCertification } from '~/lib/certifications/registry';
import { certificationIdFromPath } from '~/lib/navigation/sidebar';
import LessonHeader from '~/components/course/LessonHeader.astro';

const { entry } = Astro.locals.starlightRoute;
const lesson = entry.data.lesson;
const certificationId = certificationIdFromPath(Astro.url.pathname);
const certification = certificationId ? getCertification(certificationId) : undefined;
const isOverview = certification && Astro.url.pathname === certificationUrl(certification.id);
const module =
  lesson && certification?.status === 'available'
    ? certification.modules.find((item) => item.slug === lesson.module)
    : undefined;
---

{certification && (
  <nav class="breadcrumbs" aria-label="Breadcrumb">
    <ol>
      <li>
        <a href="/certifications/">Certifications</a>
      </li>
      {isOverview ? (
        <li aria-current="page">{certification.shortTitle}</li>
      ) : (
        <li>
          <a href={certificationUrl(certification.id)}>{certification.shortTitle}</a>
        </li>
      )}
      {module && <li>{module.title}</li>}
    </ol>
  </nav>
)}

<h1 id="_top">{entry.data.title}</h1>

{lesson && certification?.status === 'available' && <LessonHeader {lesson} {certification} />}

<style>
  .breadcrumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-2);
    margin: var(--space-3) 0 0;
    padding: 0;
    list-style: none;
    font: 500 var(--sl-text-2xs) / 1.5 var(--font-data);
    color: var(--color-text-muted);
  }

  .breadcrumbs li + li::before {
    content: '/';
    margin-inline-end: var(--space-2);
  }

  .breadcrumbs a {
    color: var(--color-accent);
  }

  h1 {
    margin-top: var(--space-3);
    font-size: clamp(2rem, 1.5rem + 2vw, 2.75rem);
    font-weight: 700;
    line-height: 1.1;
    color: var(--color-text-strong);
  }
</style>
