---
import Default from '@astrojs/starlight/components/Footer.astro';
import LessonFooter from '~/components/course/LessonFooter.astro';
import { siteConfig } from '~/config/site';

const lesson = Astro.locals.starlightRoute.entry.data.lesson;
const title = Astro.locals.starlightRoute.entry.data.title;
---

{lesson && <LessonFooter {lesson} {title} />}
<Default />

<div class="site-footer">
  <nav aria-label="Footer">
    <a href="/certifications/">Certifications</a>
    <a href="/progress/">My progress</a>
    <a href="/support/">Support this project</a>
    <a href={siteConfig.repositoryUrl}>Source on GitHub</a>
  </nav>
  <p>{siteConfig.disclaimer}</p>
  <p>Architecture diagrams use official AWS Architecture Icons.</p>
</div>

<style>
  .site-footer {
    margin-top: var(--space-7);
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-border);
    font-size: var(--sl-text-xs);
    color: var(--color-text-muted);
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    margin-bottom: var(--space-3);
  }

  a {
    color: var(--color-text);
  }

  a:hover {
    color: var(--color-accent);
  }

  p {
    margin: var(--space-2) 0 0;
    max-width: 48rem;
  }
</style>
