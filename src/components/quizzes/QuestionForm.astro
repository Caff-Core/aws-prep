---
import { orderOptions } from '~/lib/assessment/option-order';
import type { Question } from '~/lib/assessment/schema';

interface Props {
  question: Question;
  number: number;
}

const { question, number } = Astro.props;
const options = orderOptions(question.id, question.options);
const numberWords = ['ZERO', 'ONE', 'TWO', 'THREE', 'FOUR', 'FIVE'];
---

<form
  data-question-id={question.id}
  data-correct={JSON.stringify(question.correctOptionIds)}
  novalidate
>
  <fieldset>
    <legend>
      <span class="question-number">Question {number}</span>
      {question.prompt}
      {question.type === 'multiple-response' && (
        <span class="choose">Choose {numberWords[question.correctOptionIds.length]}.</span>
      )}
    </legend>
    <ul class="options">
      {options.map((option) => (
        <li data-option={option.id}>
          <label>
            <input
              type={question.type === 'single-answer' ? 'radio' : 'checkbox'}
              name={question.id}
              value={option.id}
            />
            <span>
              {option.text}
              <strong class="verdict" hidden />
            </span>
          </label>
          <p class="option-explanation" hidden>
            {option.explanation}
          </p>
        </li>
      ))}
    </ul>
  </fieldset>

  <div class="actions">
    <button type="submit" class="button">
      Check answer
    </button>
    <button type="button" class="button" data-variant="secondary" data-retry hidden>
      Try again
    </button>
  </div>
  <p class="feedback" role="status" data-feedback />
  <div class="explanation" data-explanation hidden>
    <p>{question.explanation}</p>
    <ul>
      {question.references.map((reference) => (
        <li>
          <a href={reference.url}>{reference.title}</a>
        </li>
      ))}
    </ul>
  </div>
</form>

<style>
  form {
    margin-top: var(--space-5);
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-border);
  }

  fieldset {
    margin: 0;
    padding: 0;
    border: 0;
  }

  legend {
    padding: 0;
    font-weight: 600;
    color: var(--color-text-strong);
  }

  .question-number {
    display: block;
    margin-bottom: var(--space-1);
    font: 500 var(--sl-text-2xs) / 1.3 var(--font-data);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .choose {
    display: block;
    margin-top: var(--space-1);
    font-weight: 700;
    color: var(--color-accent);
  }

  .options {
    margin: var(--space-3) 0 0;
    padding: 0;
    list-style: none;
  }

  .options li {
    margin-top: var(--space-2);
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius-md);
    transition: border-color var(--transition-fast);
  }

  .options li:hover:not([data-state]) {
    border-color: var(--color-border-strong);
  }

  .options li:has(input:checked):not([data-state]) {
    border-color: var(--color-accent);
    background: var(--color-accent-soft);
  }

  .options li:has(input:focus-visible) {
    outline: var(--focus-ring);
    outline-offset: 2px;
  }

  .options li[data-state='correct'] {
    border-color: var(--color-success);
    background: var(--color-success-soft);
  }

  .options li[data-state='incorrect'] {
    border-color: var(--color-danger);
    background: var(--color-danger-soft);
  }

  label {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    padding: var(--space-3);
    cursor: pointer;
  }

  li[data-state] label {
    cursor: default;
  }

  input {
    flex: none;
    width: 1.1rem;
    height: 1.1rem;
    margin-top: 0.25rem;
    accent-color: var(--color-accent);
  }

  .verdict {
    display: block;
    font-size: var(--sl-text-sm);
    color: var(--color-text-strong);
  }

  .verdict[hidden] {
    display: none;
  }

  .option-explanation {
    margin: 0;
    padding: 0 var(--space-3) var(--space-3) calc(1.1rem + var(--space-3) * 2);
    font-size: var(--sl-text-sm);
  }

  .actions {
    margin-top: var(--space-4);
  }

  .feedback {
    margin: var(--space-3) 0 0;
    font-weight: 700;
  }

  .score:empty {
    display: none;
  }

  .feedback[data-state='correct'] {
    color: var(--color-success);
  }

  .feedback[data-state='incorrect'] {
    color: var(--color-danger);
  }

  .explanation {
    margin-top: var(--space-2);
  }

  .explanation p {
    margin: 0;
  }

  .explanation ul {
    margin: var(--space-2) 0 0;
    padding-inline-start: var(--space-5);
    font-size: var(--sl-text-sm);
  }

  .explanation a {
    color: var(--color-accent);
  }
</style>
